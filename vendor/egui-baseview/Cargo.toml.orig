[package]
name = "egui-baseview"
version = "0.7.2"
edition = "2024"
authors = ["Billy Messenger <billydm@noreply.codeberg.org>"]
repository = "https://codeberg.org/RustAudio/egui-baseview"
license = "MIT OR Apache-2.0"
description = "A baseview backend for egui"
keywords = ["nice-plug", "plugin", "clap", "vst", "vst3"]
categories = ["gui"]
readme = "README.md"

[features]
default = ["opengl", "tracing"]
opengl = ["dep:egui_glow", "baseview/opengl"]
wgpu = ["dep:egui-wgpu", "dep:pollster", "dep:wgpu"]
## Enables a temporary workaround for keyboard input not working sometimes.
## See https://codeberg.org/RustAudio/egui-baseview/issues/20
keyboard_focus_workaround = []
## Enables logging using `tracing`
tracing = ["dep:tracing", "baseview/tracing"]
## Enables logging using `log`
log = ["dep:log"]

[dependencies]
baseview = "0.3.4"
raw-window-handle = "0.6"
egui = { version = "0.36.1", default-features = false, features = ["bytemuck"] }
egui_glow = { version = "0.36.1", features = ["x11"], optional = true }
egui-wgpu = { version = "0.36.1", features = ["x11"], optional = true }
wgpu = { version = "30", optional = true }
keyboard-types = { version = "0.8.3", default-features = false }
copypasta = { version = "0.10", default-features = false, features = ["x11"] }
tracing = { version = "0.1", optional = true }
log = { version = "0.4", optional = true }
open = "5.4.1"
pollster = { version = "1.0", optional = true }
thiserror = "2"

[dev-dependencies]
egui = { version = "0.36.1", features = ["default_fonts"] }
